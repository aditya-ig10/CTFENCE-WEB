# google analytics 4 measurement id. set a real one before deploying;
# empty/disabling this env var turns all GA off.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# emailjs — newsletter signup flow. templates: email-templates/autoreply.html
# (template_m2an2mn, auto-reply to the subscriber) and
# email-templates/notify.html (template_k4an26, subscriber record).
# without EMAILJS_PUBLIC_KEY the join endpoint accepts signups and sends nothing.
# EMAILJS_PRIVATE_KEY is required when "Allow EmailJS API for non-browser
# applications" is on (strict mode) — every request must carry the accessToken.
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
EMAILJS_SERVICE_ID=service_7ryyk2d
EMAILJS_TEMPLATE_REPLY=template_m2an2mn
EMAILJS_TEMPLATE_NOTIFY=template_k4an26
EMAILJS_OWNER_EMAIL=you@yourdomain.com

# firebase — website login (google sign-in). public client-side config,
# safe to expose: access rules live in the firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# razorpay — standard checkout. KEY_ID is public (frontend), KEY_SECRET is
# server-only. NEXT_PUBLIC_RAZORPAY_KEY_ID must equal RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=