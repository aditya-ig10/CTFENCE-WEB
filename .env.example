# google analytics 4 measurement id. set a real one before deploying;
# empty/disabling this env var turns all GA off.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# emailjs — newsletter signup flow. templates: email-templates/autoreply.html
# (template_m2an2mn, auto-reply to the subscriber) and
# email-templates/notify.html (template_k4an26, subscriber record).
# without EMAILJS_PUBLIC_KEY the join endpoint accepts signups and sends nothing.
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=service_7ryyk2d
EMAILJS_TEMPLATE_REPLY=template_m2an2mn
EMAILJS_TEMPLATE_NOTIFY=template_k4an26
EMAILJS_OWNER_EMAIL=you@yourdomain.com