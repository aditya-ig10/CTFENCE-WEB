rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'ssynthrun@gmail.com';
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isIncomingDocOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ─── USER PROFILES ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Legacy per-user transaction subcollection
    match /users/{userId}/transactions/{txId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── PAYMENTS & INVOICES ───────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow create: if (isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.plan is string) || isAdmin();
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── SUBSCRIPTIONS (Single Source of Truth) ───────────────────────────────
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Writes are performed by server-side Razorpay webhook or owner initializing tier or admin
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── CLOUD FLEET NODES ─────────────────────────────────────────────────────
    match /cloud_fleet_nodes/{nodeId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner() && request.resource.data.nodeId is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // ─── CLOUD BACKUP TABLES FOR PAID USERS ────────────────────────────────────

    // 1. Full system snapshot backups
    match /cloud_backups/{backupId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.backupVersion is string
        && request.resource.data.timestamp is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // 2. Exported firewall policies & rules
    match /cloud_policies/{policyId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.ruleName is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // 3. Agent configuration & connector protection states
    match /cloud_agent_configs/{configId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.agentType is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // 4. Cloud audit logs & forensic event logs (append-only for audit integrity)
    match /cloud_audit_logs/{logId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.timestamp is string
        && request.resource.data.verdict is string) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 6. Policy change approvals & sign-offs
    match /change_approvals/{approvalId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.title is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // 7. Compliance reports & evidence packs
    match /compliance_reports/{reportId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.framework is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // 8. Incident replays & forensic traces
    match /incident_replays/{incidentId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if (isIncomingDocOwner()
        && request.resource.data.incidentId is string) || isAdmin();
      allow update: if (isDocOwner() && isIncomingDocOwner()) || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // ─── ADMIN SPECIFIC TABLES ────────────────────────────────────────────────
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_ip_bans/{banId} {
      allow read, write: if isAdmin();
    }

    // ─── DEFAULT DENY ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
